<Window
    x:Class="JianyingVideoAssistant.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:JianyingVideoAssistant"
    xmlns:models="using:JianyingVideoAssistant.Models"
    xmlns:viewModels="using:JianyingVideoAssistant.ViewModels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="剪映视频助手">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="18,0,140,0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Border Width="25" Height="25" CornerRadius="7" Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <FontIcon Glyph="&#xE714;" FontSize="13" Foreground="White" />
                </Border>
                <TextBlock Text="剪映视频助手" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Text="项目工作台" Foreground="{StaticResource MutedTextBrush}" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <NavigationView
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsPaneToggleButtonVisible="True"
            PaneDisplayMode="LeftCompact"
            OpenPaneLength="208"
            SelectedItem="{x:Bind WorkspaceItem}">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Name="WorkspaceItem" Content="当前项目" Icon="Home" />
                <NavigationViewItemSeparator />
                <NavigationViewItemHeader Content="资料管理 · 后续开放" />
                <NavigationViewItem Content="素材库" Icon="Pictures" IsEnabled="False" />
                <NavigationViewItem Content="内容文库" Icon="Document" IsEnabled="False" />
                <NavigationViewItem Content="音乐库" Icon="Audio" IsEnabled="False" />
                <NavigationViewItem Content="草稿记录" Icon="Save" IsEnabled="False" />
            </NavigationView.MenuItems>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <Grid Padding="28,20,28,32" MaxWidth="1480" HorizontalAlignment="Stretch">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Spacing="5">
                            <TextBlock Text="{x:Bind ViewModel.Greeting, Mode=OneWay}" FontSize="13" Foreground="{StaticResource MutedTextBrush}" />
                            <TextBlock Text="{x:Bind ViewModel.ProjectName, Mode=OneWay}" FontSize="30" FontWeight="SemiBold" />
                            <TextBlock Text="本地工作台 · 素材源文件始终保持不变" Foreground="{StaticResource MutedTextBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1" Command="{x:Bind ViewModel.NewProjectCommand}" Style="{StaticResource AccentButtonStyle}" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="13" />
                                <TextBlock Text="新建项目" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <Border Grid.Row="1" Style="{StaticResource GlassCardStyle}" Margin="0,22,0,14">
                        <Grid ColumnSpacing="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Width="42" Height="42" CornerRadius="12" Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                <FontIcon Glyph="&#xE9D9;" FontSize="18" />
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="5" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" FontWeight="SemiBold" />
                                <ProgressBar Value="{x:Bind ViewModel.Progress, Mode=OneWay}" Maximum="100" Height="4" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{x:Bind ViewModel.ProgressLabel, Mode=OneWay}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </Grid>
                    </Border>

                    <ItemsRepeater Grid.Row="2" ItemsSource="{x:Bind ViewModel.WorkflowSteps}">
                        <ItemsRepeater.Layout>
                            <UniformGridLayout MinItemWidth="250" MinColumnSpacing="12" MinRowSpacing="12" />
                        </ItemsRepeater.Layout>
                        <ItemsRepeater.ItemTemplate>
                            <DataTemplate x:DataType="viewModels:WorkflowStepViewModel">
                                <Border Style="{StaticResource GlassCardStyle}" Margin="0,0,12,0" MinHeight="205">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="10" Background="{ThemeResource AccentFillColorSecondaryBrush}">
                                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="15" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                <Border Padding="8,3" CornerRadius="10" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                    <TextBlock Text="{x:Bind IndexLabel}" FontSize="11" />
                                                </Border>
                                                <Border Padding="8,3" CornerRadius="10" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                    <TextBlock Text="{x:Bind AvailabilityLabel}" FontSize="11" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                        <StackPanel Grid.Row="1" Margin="0,14,0,0" Spacing="5">
                                            <TextBlock Text="{x:Bind Title}" FontSize="18" FontWeight="SemiBold" />
                                            <TextBlock Text="{x:Bind Description}" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
                                        </StackPanel>
                                        <TextBlock Grid.Row="2" Margin="0,14,0,14" Text="{x:Bind Summary, Mode=OneWay}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                        <Button
                                            Grid.Row="3"
                                            Content="{x:Bind ActionLabel}"
                                            Command="{x:Bind PrimaryCommand}"
                                            IsEnabled="{x:Bind IsActionEnabled}"
                                            HorizontalAlignment="Stretch" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsRepeater.ItemTemplate>
                    </ItemsRepeater>

                    <Grid Grid.Row="3" Margin="0,14,0,0">
                        <Border Style="{StaticResource GlassCardStyle}">
                            <StackPanel Spacing="14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="项目素材" FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="导入后即可使用，自动分类可以随时纠正" Foreground="{StaticResource MutedTextBrush}" />
                                    </StackPanel>
                                    <Button
                                        Grid.Column="1"
                                        Content="{x:Bind ViewModel.ImportActionLabel, Mode=OneWay}"
                                        Command="{x:Bind ViewModel.ImportMediaCommand}" />
                                </Grid>
                                <Border Padding="14" CornerRadius="12" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ProgressRing
                                            Width="24"
                                            Height="24"
                                            IsActive="{x:Bind ViewModel.IsImporting, Mode=OneWay}"
                                            VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" Spacing="3">
                                            <TextBlock Text="{x:Bind ViewModel.ImportStatusTitle, Mode=OneWay}" FontWeight="SemiBold" />
                                            <TextBlock
                                                Text="{x:Bind ViewModel.ImportStatusDetail, Mode=OneWay}"
                                                TextWrapping="Wrap"
                                                Foreground="{StaticResource MutedTextBrush}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <ListView
                                    MaxHeight="390"
                                    ItemsSource="{x:Bind ViewModel.RecentAssets}"
                                    SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:MediaAsset">
                                            <Grid Padding="0,7" ColumnSpacing="12" ToolTipService.ToolTip="{x:Bind FullPath}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="122" />
                                                </Grid.ColumnDefinitions>
                                                <Border Width="44" Height="44" CornerRadius="10" Background="{ThemeResource ControlFillColorSecondaryBrush}">
                                                    <FontIcon Glyph="&#xEB9F;" FontSize="16" />
                                                </Border>
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind Detail}" FontSize="12" Foreground="{StaticResource MutedTextBrush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                                    <ComboBox
                                                        MinWidth="110"
                                                        ItemsSource="{Binding CategoryOptions}"
                                                        SelectedItem="{Binding Category, Mode=TwoWay}" />
                                                    <TextBlock
                                                        Text="{x:Bind CategorySourceLabel, Mode=OneWay}"
                                                        FontSize="11"
                                                        Foreground="{StaticResource MutedTextBrush}"
                                                        HorizontalAlignment="Right" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </StackPanel>
                        </Border>

                    </Grid>

                    <InfoBar
                        Grid.Row="4"
                        Margin="0,14,0,0"
                        IsOpen="True"
                        IsClosable="False"
                        Severity="Informational"
                        Title="草稿安全模式"
                        Message="当前版本只预览生成结果；接入真实剪映格式后也只创建副本，不覆盖原草稿。" />
                </Grid>
            </ScrollViewer>
        </NavigationView>
    </Grid>
</Window>
