<Window x:Class="JianyingVideoAssistant.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="剪映视频助手"
        Width="1180" Height="840" MinWidth="1024" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBrush}"
        Foreground="{DynamicResource PrimaryTextBrush}"
        SourceInitialized="OnSourceInitialized"
        Loaded="OnLoaded"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource RailBrush}"
                BorderBrush="{DynamicResource CardStrokeBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="14,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="26" Height="26" CornerRadius="7"
                        Background="{DynamicResource AccentBrush}"
                        VerticalAlignment="Center">
                    <TextBlock Text="剪" Foreground="White" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Grid.Column="1" Text="剪映视频助手" Margin="9,0,0,0"
                           FontWeight="SemiBold" VerticalAlignment="Center" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0"
                            VerticalAlignment="Center">
                    <Ellipse x:Name="ConnectionDot" Width="7" Height="7"
                             Fill="{DynamicResource WarningBrush}" />
                    <TextBlock x:Name="ConnectionText" Text="正在连接"
                               Margin="6,0,0,0" FontSize="12"
                               Foreground="{DynamicResource MutedTextBrush}" />
                    <ProgressBar x:Name="NavigationProgress" Width="70" Height="3"
                                 Margin="10,0,0,0" IsIndeterminate="True" />
                </StackPanel>
                <Button Grid.Column="3" Content="刷新" Click="OnReloadClick"
                        Padding="12,5" MinHeight="30" />
                <Button Grid.Column="4" Content="在浏览器打开" Click="OnOpenBrowserClick"
                        Margin="8,0,0,0" Padding="12,5" MinHeight="30" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <wv2:WebView2 x:Name="WorkbenchBrowser" />

            <Border x:Name="LoadingPanel" Background="{DynamicResource WindowBrush}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ProgressBar Width="220" Height="4" IsIndeterminate="True" />
                    <TextBlock Text="正在打开视频生产工作台…" Margin="0,18,0,0"
                               HorizontalAlignment="Center" FontSize="15" />
                </StackPanel>
            </Border>

            <Border x:Name="ErrorPanel" Visibility="Collapsed"
                    Background="{DynamicResource WindowBrush}">
                <Border Style="{StaticResource GlassCardStyle}" Width="520"
                        HorizontalAlignment="Center" VerticalAlignment="Center" Padding="28">
                    <StackPanel>
                        <TextBlock Text="工作台暂时无法打开" FontSize="22" FontWeight="SemiBold" />
                        <TextBlock x:Name="ErrorDetail" Margin="0,10,0,20"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="重试" Click="OnRetryClick"
                                    Style="{StaticResource PrimaryButtonStyle}" MinWidth="110" />
                            <Button Content="在浏览器打开" Click="OnOpenBrowserClick"
                                    Margin="10,0,0,0" MinWidth="130" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Grid>
</Window>
