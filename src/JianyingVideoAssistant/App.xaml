<Application x:Class="JianyingVideoAssistant.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="WindowBrush" Color="#E6121620" />
            <SolidColorBrush x:Key="RailBrush" Color="#B9121620" />
            <SolidColorBrush x:Key="CardBackgroundBrush" Color="#C51D2330" />
            <SolidColorBrush x:Key="CardStrokeBrush" Color="#32FFFFFF" />
            <SolidColorBrush x:Key="MutedTextBrush" Color="#B8FFFFFF" />
            <SolidColorBrush x:Key="AccentBrush" Color="#7C5CFC" />
            <SolidColorBrush x:Key="AccentHoverBrush" Color="#9278FF" />
            <SolidColorBrush x:Key="SuccessBrush" Color="#4FD1A1" />
            <SolidColorBrush x:Key="WarningBrush" Color="#FFCC66" />

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="#F4F5F8" />
                <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
            </Style>
            <Style TargetType="Control">
                <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
                <Setter Property="FontSize" Value="13" />
            </Style>
            <Style TargetType="Button">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="Background" Value="#2B3242" />
                <Setter Property="BorderBrush" Value="#40FFFFFF" />
                <Setter Property="Padding" Value="14,9" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="MinHeight" Value="38" />
            </Style>
            <Style x:Key="PrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>
            <Style TargetType="TextBox">
                <Setter Property="Foreground" Value="#F4F5F8" />
                <Setter Property="Background" Value="#D2181D27" />
                <Setter Property="BorderBrush" Value="#40FFFFFF" />
                <Setter Property="Padding" Value="10,8" />
            </Style>
            <Style TargetType="ComboBox">
                <Setter Property="Foreground" Value="#171923" />
                <Setter Property="Background" Value="#EEF1F7" />
                <Setter Property="Padding" Value="8,5" />
                <Setter Property="MinHeight" Value="36" />
            </Style>
            <Style TargetType="ListBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <Style x:Key="GlassCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
                <Setter Property="BorderBrush" Value="{StaticResource CardStrokeBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="18" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
